# Copy to .env and fill in. Never commit the real .env.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Local development (no database server needed) ---
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- MySQL via Docker Compose: comment out the block above and use these ---
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=student_management_db
# DB_USER=sms_user
# DB_PASSWORD=sms_password
# DB_ROOT_PASSWORD=root_password
# DB_HOST=db
# DB_PORT=3306

# Notifications. Leave SMS_BACKEND empty to log messages instead of sending.
SMS_BACKEND=
DEFAULT_FROM_EMAIL=noreply@smartsms.local
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Online payments. Empty uses the console stub, which settles nothing and must
# never run in production. For live collection:
#   PAYMENT_GATEWAY=apps.fees.gateways.RazorpayGateway
PAYMENT_GATEWAY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
